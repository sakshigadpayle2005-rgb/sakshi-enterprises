# Sakshi Enterprises — Production Contact Configuration
# Copy this file to .env before building for production.

# Official WhatsApp number in international format without '+' (e.g., 9198XXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Official voice call phone number (e.g., +91 98XXX XXXXX)
VITE_BUSINESS_PHONE=

# Official business email address (optional)
VITE_BUSINESS_EMAIL=

# Official street address in Nagpur, Maharashtra (optional)
VITE_BUSINESS_ADDRESS=
